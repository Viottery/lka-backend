# Load these into the connector process environment. No automatic .env loading.
# Credentials are created/read locally, never supplied as command-line arguments.
LKA_CONNECTOR_DATA_DIR=data/message-connector
LKA_CONNECTOR_BACKEND_URL=http://127.0.0.1:8765
LKA_MESSAGES_IMPORT_TOKEN=
# Optional separate read credential for backend-produced analysis via MCP.
LKA_MESSAGES_API_TOKEN=
LKA_TG_API_ID=
LKA_TG_API_HASH=
# After explicit login, pin the returned numeric account ID before capture.
LKA_TG_ACCOUNT_ID=
# Optional authenticated SOCKS5/SOCKS4/HTTP proxy; percent-encode credentials.
LKA_TG_PROXY_URL=
# Required only for Streamable HTTP. Use a separate random token, >=32 characters.
LKA_CONNECTOR_MCP_TOKEN=
# Optional JSON array of allowed conversation keys. [] denies all content reads.
# Unset means every currently approved conversation captured by this module.
LKA_CONNECTOR_MCP_SCOPE=
LKA_CONNECTOR_POLICY_INTERVAL=10
LKA_CONNECTOR_SYNC_INTERVAL=2
LKA_CONNECTOR_MAX_PENDING=10000
LKA_CONNECTOR_MEDIA_ENABLED=false
LKA_CONNECTOR_MEDIA_TTL_SECONDS=259200
LKA_CONNECTOR_MEDIA_MAX_BYTES=2147483648
LKA_CONNECTOR_IMAGE_MAX_BYTES=20971520
LKA_CONNECTOR_VIDEO_MAX_BYTES=209715200
