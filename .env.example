LKA_APP_NAME=local-knowledge-agent-os
LKA_VERSION=0.2.0
LKA_HOST=127.0.0.1
LKA_PORT=8765
# Runtime-only state: SQLite, run logs, imported personal knowledge, and local mail.
# Tests and evals use temporary directories and must not write here.
LKA_DATA_DIR=./data/runtime
# Local rotating JSONL: phase timings, HTTP correlation and complete histograms.
# Fast detail records are sampled; slow operations and errors are always logged.
LKA_DB_TIMING_ENABLED=true
LKA_DB_TIMING_SAMPLE_RATE=0.01
LKA_DB_TIMING_SLOW_MS=50
# Per-database FIFO write admission and transaction watchdog (seconds).
LKA_DB_WRITE_QUEUE_CAPACITY=128
LKA_DB_WRITE_QUEUE_WAIT_SECONDS=5
LKA_DB_WRITE_TRANSACTION_SECONDS=30
# Durable input/dispatch scheduling. poll is a compatibility fallback;
# shadow observes without starting a second admission consumer.
# Active Agent executions; separate from DB pools, session ownership and LLM limits.
LKA_AGENT_EXECUTION_CONCURRENCY=4
LKA_AGENT_EXECUTION_INTERACTIVE_RESERVED=2
LKA_AGENT_CHILD_EXECUTION_CONCURRENCY=2
LKA_SCHEDULING_MODE=event
LKA_SCHEDULING_RECONCILE_SECONDS=30
LKA_SCHEDULING_CAPACITY=1024
LKA_SCHEDULING_WORKERS=2
LKA_SCHEDULING_RECOVERY_PAGE_SIZE=128
LKA_SCHEDULING_STOP_SECONDS=45
LKA_PLATFORM=auto
LKA_DEFAULT_SHELL=auto
LKA_WORKSPACE_ROOTS=
# Linux backends running under WSL map C:/... to /mnt/c/... by default.
LKA_WSL_WINDOWS_MOUNT_ROOT=/mnt
LKA_CORS_ORIGINS=http://127.0.0.1:8780;http://localhost:8780;http://127.0.0.1:8000;http://localhost:8000
LKA_ALLOW_SYMLINKS=false
LKA_SKIP_HIDDEN=true
LKA_MAX_SCAN_FILES=50000
LKA_LOCAL_CONFIG=./config/local.toml
# Optional: enables the web.search tool (web.open works without a key).
BRAVE_SEARCH_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
# Optional replica-only credential, issued by authenticated device enrollment.
# Keep the real value local; this is distinct from user sessions and message tokens.
LKA_NODE_TOKEN=

# Optional MySQL authority (install schema separately; SQLite remains default).
# Install dependencies: uv sync --locked --extra mysql
# LKA_STORAGE_BACKEND=mysql
# LKA_MYSQL_HOST=127.0.0.1
# LKA_MYSQL_PORT=3306
# LKA_MYSQL_DATABASE=lka
# LKA_MYSQL_USER=lka
# LKA_MYSQL_PASSWORD=<private runtime account password>
# LKA_MYSQL_POOL_SIZE=8
# LKA_MYSQL_POOL_QUEUE_CAPACITY=128
# LKA_MYSQL_POOL_WAIT_SECONDS=5
# LKA_MYSQL_LOCK_WAIT_SECONDS=5
