LKA_APP_NAME=local-knowledge-agent-os
LKA_VERSION=0.1.0
LKA_HOST=127.0.0.1
LKA_PORT=8765
# Runtime-only state: SQLite, run logs, imported personal knowledge, and local mail.
# Tests and evals use temporary directories and must not write here.
LKA_DATA_DIR=./data/runtime
LKA_PLATFORM=auto
LKA_DEFAULT_SHELL=auto
LKA_WORKSPACE_ROOTS=
# Linux backends running under WSL map C:/... to /mnt/c/... by default.
LKA_WSL_WINDOWS_MOUNT_ROOT=/mnt
LKA_CORS_ORIGINS=http://127.0.0.1:8780;http://localhost:8780;http://127.0.0.1:8000;http://localhost:8000
LKA_ALLOW_SYMLINKS=false
LKA_SKIP_HIDDEN=true
LKA_MAX_SCAN_FILES=50000
LKA_LOCAL_CONFIG=./config/local.toml
# Optional: enables the web.search tool (web.open works without a key).
BRAVE_SEARCH_API_KEY=
QDRANT_URL=http://127.0.0.1:6333
