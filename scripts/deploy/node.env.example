# Private target /etc/lka/node.env on THIS Linux computer.
# Install provider credentials and this device's one-time token privately.
LKA_DATA_DIR=/var/lib/lka-node/runtime
LKA_LOCAL_CONFIG=/etc/lka/node.toml
LKA_WORKSPACE_ROOTS=/home/me/Workspaces
LKA_PLATFORM=linux
# LKA_NODE_TOKEN=<this node's enrollment token; never commit a real value>
