[Unit]
Description=LKA cloud assistant backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lka
Group=lka
WorkingDirectory=/opt/lka-backend
EnvironmentFile=/etc/lka/backend.env
ExecStart=/opt/lka-backend/.venv/bin/python scripts/start_backend.py personal --require-auth --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
