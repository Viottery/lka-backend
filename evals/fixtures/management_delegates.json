        "current_amount": 7200,
        "approval_threshold": 5000,
        "current_approval_present": false,
        "old_approval_reusable": false,
        "execution_allowed": false,
        "source_ids": [
          "P-CURRENT-71",
          "P-OLD-11",
          "POLICY-83"
        ]
      },
      "delegate_count": 1,
      "task_count": 2,
      "needs_decision": true,
      "historical_status": "unvalidated_budget_exhausted"
