{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LKA Reviewed Badcase Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "manifest_id", "cases"],
  "properties": {
    "manifest_version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "task", "agent_id", "executor_type", "severity", "privacy_reviewed", "checks"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1, "description": "Manually sanitized task text; never raw production prompt/log content."},
          "agent_id": {"type": "string", "minLength": 1},
          "executor_type": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "fixture_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "privacy_reviewed": {"const": true},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "operator", "value"],
              "properties": {
                "metric": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
                "operator": {"enum": ["eq", "gte", "lte", "contains", "not_contains"]},
                "value": {"type": ["string", "number", "integer", "boolean"]}
              }
            }
          }
        }
      }
    }
  }
}
